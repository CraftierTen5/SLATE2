# Local backend environment. Copy to .env at the repository root; never commit real keys.
# Gemini interview coaching (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Groq key (server-side only, never commit it). Used for AI resume tailoring and for the PDF-upload explanation,
# which runs by default for users who acknowledge the on-page Groq notice. Without it, parser results still work.
# Not used for Gemini interview coaching.
LLM_API_KEY=
# Local development only. Never enable this on a public deployment.
SLATE_DEV_AUTH=1
# Optional durable local state; omit to use an ephemeral in-memory store.
SLATE_STATE_URL=sqlite:///slate_state.db
